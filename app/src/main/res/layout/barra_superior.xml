<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:id="@+id/barra_superior"
    android:background="@color/magenta"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:minHeight="64dp"
    android:elevation="4dp">
    <ImageButton
        android:id="@+id/boton_menu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_menu_hamburguesa"
        android:scaleType="center"
        android:contentDescription="Abrir menú" />
    <ImageView
        android:layout_width="52dp"
        android:layout_height="48dp"
        android:src="@drawable/logo_lobos_web"
        android:scaleType="fitCenter"
        android:layout_marginStart="6dp"
        android:contentDescription="Logo Academia Lobos" />
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Academia Lobos"
        android:textSize="17sp"
        android:textColor="@color/blanco"
        android:textStyle="bold"
        android:layout_weight="1"
        android:layout_marginStart="8dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Administrador"
        android:textSize="12sp"
        android:textColor="@color/blanco"
        android:layout_marginEnd="8dp" />
</LinearLayout>
