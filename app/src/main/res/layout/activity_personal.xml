<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/drawer_layout">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:id="@+id/main"
        android:background="@color/gris_fondo">
        <include
            layout="@layout/barra_superior" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Personal"
                        android:textSize="26sp"
                        android:textColor="@color/negro"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Administración de profesores y personal administrativo."
                        android:textSize="13sp"
                        android:textColor="@color/gris"
                        android:layout_marginTop="4dp" />
                    <View
                        android:layout_width="50dp"
                        android:layout_height="4dp"
                        android:background="@color/magenta"
                        android:layout_marginTop="10dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/modulo_profesores"
                    android:background="@drawable/fondo_card"
                    android:padding="20dp"
                    android:layout_marginBottom="14dp"
                    android:clickable="true">
                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:text="P"
                        android:textSize="22sp"
                        android:textColor="@color/blanco"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/fondo_avatar_grande" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Administrar Profesores"
                        android:textSize="18sp"
                        android:textColor="@color/negro"
                        android:textStyle="bold"
                        android:layout_marginTop="14dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consulta y administración de profesores de la Academia."
                        android:textSize="13sp"
                        android:textColor="@color/gris"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/modulo_administrativo"
                    android:background="@drawable/fondo_card"
                    android:padding="20dp"
                    android:layout_marginBottom="14dp"
                    android:clickable="true">
                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:text="A"
                        android:textSize="22sp"
                        android:textColor="@color/blanco"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/fondo_avatar_grande" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Administrar Personal"
                        android:textSize="18sp"
                        android:textColor="@color/negro"
                        android:textStyle="bold"
                        android:layout_marginTop="14dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consulta y administración del personal administrativo."
                        android:textSize="13sp"
                        android:textColor="@color/gris"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <include
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        layout="@layout/menu_lateral" />
</androidx.drawerlayout.widget.DrawerLayout>
