<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/drawer_layout">
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/gris_fondo">
        <include
            layout="@layout/barra_superior" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:id="@+id/form_titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nuevo alumno"
                        android:textSize="26sp"
                        android:textColor="@color/negro"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/form_subtitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Registra los datos del alumno."
                        android:textSize="13sp"
                        android:textColor="@color/gris"
                        android:layout_marginTop="4dp" />
                    <View
                        android:layout_width="50dp"
                        android:layout_height="4dp"
                        android:background="@color/magenta"
                        android:layout_marginTop="10dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/fondo_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Información personal"
                            android:textSize="16sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nombre(s) *"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/f_nombre"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint=""
                            android:textSize="14sp"
                            android:inputType="textPersonName|textCapWords"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/fondo_input"
                            android:textColor="@color/negro"
                            android:textColorHint="@color/gris"
                            android:singleLine="true" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Apellido paterno *"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/f_paterno"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint=""
                            android:textSize="14sp"
                            android:inputType="textPersonName|textCapWords"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/fondo_input"
                            android:textColor="@color/negro"
                            android:textColorHint="@color/gris"
                            android:singleLine="true" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Apellido materno"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/f_materno"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint=""
                            android:textSize="14sp"
                            android:inputType="textPersonName|textCapWords"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/fondo_input"
                            android:textColor="@color/negro"
                            android:textColorHint="@color/gris"
                            android:singleLine="true" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fecha de nacimiento *"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/f_fecha_nac"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint="dd/mm/aaaa"
                            android:textSize="14sp"
                            android:inputType="none"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/fondo_input"
                            android:textColor="@color/negro"
                            android:textColorHint="@color/gris"
                            android:singleLine="true"
                            android:focusable="false"
                            android:clickable="true" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CURP"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/f_curp"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint="18 caracteres"
                            android:textSize="14sp"
                            android:inputType="textCapCharacters"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/fondo_input"
                            android:textColor="@color/negro"
                            android:textColorHint="@color/gris"
                            android:singleLine="true" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Escuela"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/f_escuela"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint=""
                            android:textSize="14sp"
                            android:inputType="textCapSentences"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/fondo_input"
                            android:textColor="@color/negro"
                            android:textColorHint="@color/gris"
                            android:singleLine="true" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dirección"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/f_direccion"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint=""
                            android:textSize="14sp"
                            android:inputType="textPostalAddress|textCapSentences"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/fondo_input"
                            android:textColor="@color/negro"
                            android:textColorHint="@color/gris"
                            android:singleLine="true" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fecha de ingreso *"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/f_ingreso"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint="dd/mm/aaaa"
                            android:textSize="14sp"
                            android:inputType="none"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/fondo_input"
                            android:textColor="@color/negro"
                            android:textColorHint="@color/gris"
                            android:singleLine="true"
                            android:focusable="false"
                            android:clickable="true" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/fondo_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Información deportiva"
                            android:textSize="16sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Categoría / equipo"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <Spinner
                            android:id="@+id/f_equipo"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:background="@drawable/fondo_input" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Número de playera"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/f_numero"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint="1 - 99"
                            android:textSize="14sp"
                            android:inputType="number"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/fondo_input"
                            android:textColor="@color/negro"
                            android:textColorHint="@color/gris"
                            android:singleLine="true" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nombre en playera"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/f_playera"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint=""
                            android:textSize="14sp"
                            android:inputType="textCapWords"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/fondo_input"
                            android:textColor="@color/negro"
                            android:textColorHint="@color/gris"
                            android:singleLine="true" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Partidos jugados"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/f_partidos"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint="0"
                            android:textSize="14sp"
                            android:inputType="number"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/fondo_input"
                            android:textColor="@color/negro"
                            android:textColorHint="@color/gris"
                            android:singleLine="true" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Goles"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/f_goles"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint="0"
                            android:textSize="14sp"
                            android:inputType="number"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/fondo_input"
                            android:textColor="@color/negro"
                            android:textColorHint="@color/gris"
                            android:singleLine="true" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/fondo_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Información médica"
                            android:textSize="16sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tipo de sangre"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <Spinner
                            android:id="@+id/f_sangre"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:entries="@array/a_sangre"
                            android:background="@drawable/fondo_input" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Alergias"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/f_alergias"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint="Ninguna"
                            android:textSize="14sp"
                            android:inputType="textCapSentences"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/fondo_input"
                            android:textColor="@color/negro"
                            android:textColorHint="@color/gris"
                            android:singleLine="true" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Seguro médico"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/f_seguro"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint="Ninguno"
                            android:textSize="14sp"
                            android:inputType="textCapSentences"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/fondo_input"
                            android:textColor="@color/negro"
                            android:textColorHint="@color/gris"
                            android:singleLine="true" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/fondo_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Familia / Tutor"
                            android:textSize="16sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Padre"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/f_padre"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint=""
                            android:textSize="14sp"
                            android:inputType="textPersonName|textCapWords"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/fondo_input"
                            android:textColor="@color/negro"
                            android:textColorHint="@color/gris"
                            android:singleLine="true" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Teléfono del padre"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/f_tel_padre"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint="10 dígitos"
                            android:textSize="14sp"
                            android:inputType="phone"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/fondo_input"
                            android:textColor="@color/negro"
                            android:textColorHint="@color/gris"
                            android:singleLine="true" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Madre"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/f_madre"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint=""
                            android:textSize="14sp"
                            android:inputType="textPersonName|textCapWords"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/fondo_input"
                            android:textColor="@color/negro"
                            android:textColorHint="@color/gris"
                            android:singleLine="true" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Teléfono de la madre"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/f_tel_madre"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint="10 dígitos"
                            android:textSize="14sp"
                            android:inputType="phone"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/fondo_input"
                            android:textColor="@color/negro"
                            android:textColorHint="@color/gris"
                            android:singleLine="true" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tutor"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/f_tutor"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint=""
                            android:textSize="14sp"
                            android:inputType="textPersonName|textCapWords"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/fondo_input"
                            android:textColor="@color/negro"
                            android:textColorHint="@color/gris"
                            android:singleLine="true" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Teléfono del tutor"
                            android:textSize="13sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/f_tel_tutor"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint="10 dígitos"
                            android:textSize="14sp"
                            android:inputType="phone"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/fondo_input"
                            android:textColor="@color/negro"
                            android:textColorHint="@color/gris"
                            android:singleLine="true" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Debe registrarse al menos un teléfono de contacto (padre, madre o tutor)."
                    android:textSize="12sp"
                    android:textColor="@color/gris"
                    android:layout_marginBottom="12dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/form_mensaje"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="@color/login_error"
                        android:layout_marginBottom="10dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/form_cancelar"
                            android:text="Cancelar"
                            android:textSize="13sp"
                            android:textColor="@color/magenta"
                            android:textStyle="bold"
                            android:background="@drawable/fondo_boton_borde"
                            android:textAllCaps="false"
                            android:minHeight="0dp"
                            android:paddingEnd="16dp"
                            android:paddingStart="16dp"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="40dp"
                            android:minWidth="0dp" />
                        <Button
                            android:id="@+id/form_guardar"
                            android:text="Guardar"
                            android:textSize="13sp"
                            android:textColor="@color/blanco"
                            android:textStyle="bold"
                            android:background="@drawable/fondo_boton_magenta"
                            android:textAllCaps="false"
                            android:minHeight="0dp"
                            android:paddingEnd="16dp"
                            android:paddingStart="16dp"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>
                    <Button
                        android:id="@+id/form_eliminar"
                        android:text="Eliminar"
                        android:textSize="13sp"
                        android:textColor="@color/estado_peligro_texto"
                        android:textStyle="bold"
                        android:background="@drawable/fondo_estado_peligro"
                        android:textAllCaps="false"
                        android:minHeight="0dp"
                        android:paddingEnd="16dp"
                        android:paddingStart="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:layout_marginTop="12dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <include
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        layout="@layout/menu_lateral" />
</androidx.drawerlayout.widget.DrawerLayout>
