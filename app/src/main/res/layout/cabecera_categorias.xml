<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Administrar categoría"
            android:textSize="26sp"
            android:textColor="@color/negro"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txt_subtitulo_cab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="@color/gris"
            android:layout_marginTop="4dp" />
        <View
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:background="@color/magenta"
            android:layout_marginTop="10dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/fondo_card"
        android:padding="16dp"
        android:layout_marginBottom="14dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Categoría"
                    android:textSize="12sp"
                    android:textColor="@color/gris"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/txt_categoria"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="@color/negro"
                    android:textStyle="bold"
                    android:layout_weight="1"
                    android:gravity="end" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/linea" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Edad"
                    android:textSize="12sp"
                    android:textColor="@color/gris"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/txt_edad"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="@color/negro"
                    android:textStyle="bold"
                    android:layout_weight="1"
                    android:gravity="end" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/linea" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Profesor"
                    android:textSize="12sp"
                    android:textColor="@color/gris"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/txt_profesor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="@color/negro"
                    android:textStyle="bold"
                    android:layout_weight="1"
                    android:gravity="end" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/linea" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Torneo"
                    android:textSize="12sp"
                    android:textColor="@color/gris"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/txt_torneo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="@color/negro"
                    android:textStyle="bold"
                    android:layout_weight="1"
                    android:gravity="end" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/linea" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <Button
                android:id="@+id/boton_editar"
                android:text="Editar equipo"
                android:textSize="13sp"
                android:textColor="@color/magenta"
                android:textStyle="bold"
                android:background="@drawable/fondo_boton_borde"
                android:textAllCaps="false"
                android:minHeight="0dp"
                android:paddingEnd="16dp"
                android:paddingStart="16dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:minWidth="0dp" />
            <Button
                android:id="@+id/boton_evaluaciones"
                android:text="Evaluaciones"
                android:textSize="13sp"
                android:textColor="@color/blanco"
                android:textStyle="bold"
                android:background="@drawable/fondo_boton_negro"
                android:textAllCaps="false"
                android:minHeight="0dp"
                android:paddingEnd="16dp"
                android:paddingStart="16dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:layout_marginStart="10dp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">
        <TextView
            android:id="@+id/txt_jugadores"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Jugadores"
            android:textSize="16sp"
            android:textColor="@color/negro"
            android:textStyle="bold"
            android:layout_weight="1" />
        <Button
            android:id="@+id/boton_agregar"
            android:text="+ Agregar jugador"
            android:textSize="13sp"
            android:textColor="@color/blanco"
            android:textStyle="bold"
            android:background="@drawable/fondo_boton_magenta"
            android:textAllCaps="false"
            android:minHeight="0dp"
            android:paddingEnd="16dp"
            android:paddingStart="16dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp" />
    </LinearLayout>
</LinearLayout>
