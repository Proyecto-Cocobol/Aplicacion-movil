<?xml version="1.0" encoding="utf-8"?>
<!-- Este Drawer Layout es el cabron que hace posible el menu lateral -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Inicio_principal_admin"
    tools:openDrawer="start"><!--Para quitar el menu lateral, solo hay que quitar esta linea-->

    <!--Este es el container de la pantalla principal-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EDF2F7">

        <!-- Aqui esta el menu superior con el menu deplegable y el logo-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#2D3748"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="-2dp">

            <ImageButton
                android:id="@+id/imageButton4"
                android:layout_width="37dp"
                android:layout_height="36dp"
                android:layout_margin="5dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/boton_menu"
                tools:layout_editor_absoluteX="16dp"
                tools:layout_editor_absoluteY="22dp" />

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="203dp"
                android:layout_height="51dp"
                app:srcCompat="@drawable/nombre_academia_lobos"
                tools:layout_editor_absoluteX="131dp"
                tools:layout_editor_absoluteY="15dp" />

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="77dp"
                android:layout_height="68dp"
                app:srcCompat="@drawable/logo_lobo"
                tools:layout_editor_absoluteX="92dp"
                tools:layout_editor_absoluteY="7dp" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--Aqui le damos formato al menu lateral-->
    <com.google.android.material.navigation.NavigationView
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:id="@+id/nav_menu_admin"
        android:background="#242C3A"
        android:layout_gravity="start"
        app:menu="@menu/menu_lateral_admin"
        app:itemTextColor="#EDF2F7"/>


</androidx.drawerlayout.widget.DrawerLayout>