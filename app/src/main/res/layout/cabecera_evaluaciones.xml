<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Evaluaciones"
            android:textSize="26sp"
            android:textColor="@color/negro"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Evaluación deportiva de los jugadores."
            android:textSize="13sp"
            android:textColor="@color/gris"
            android:layout_marginTop="4dp" />
        <View
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:background="@color/magenta"
            android:layout_marginTop="10dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jugador"
                android:textSize="11sp"
                android:textColor="@color/gris"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <Spinner
                android:id="@+id/fil_jugador"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/fondo_input" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/fondo_header_alumno"
        android:padding="18dp"
        android:layout_marginBottom="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/txt_alumno_avatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text=""
                android:textSize="20sp"
                android:textColor="@color/blanco"
                android:textStyle="bold"
                android:background="@drawable/fondo_avatar_grande"
                android:gravity="center" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginStart="14dp">
                <TextView
                    android:id="@+id/txt_alumno_nombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="20sp"
                    android:textColor="@color/blanco"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txt_alumno_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="@color/gris_claro"
                    android:layout_marginTop="2dp" />
                <TextView
                    android:id="@+id/txt_promedio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="@color/blanco"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tab_todas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todas"
                android:textSize="13sp"
                android:textColor="@color/gris"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
            <TextView
                android:id="@+id/tab_tecnico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Técnico"
                android:textSize="13sp"
                android:textColor="@color/gris"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
            <TextView
                android:id="@+id/tab_tactico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Táctico"
                android:textSize="13sp"
                android:textColor="@color/gris"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
            <TextView
                android:id="@+id/tab_fisico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Físico"
                android:textSize="13sp"
                android:textColor="@color/gris"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
            <TextView
                android:id="@+id/tab_mental"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mental"
                android:textSize="13sp"
                android:textColor="@color/gris"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
            <TextView
                android:id="@+id/tab_general"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="General"
                android:textSize="13sp"
                android:textColor="@color/gris"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>
    </HorizontalScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_marginBottom="6dp">
        <Button
            android:id="@+id/boton_agregar"
            android:text="+ Evaluación"
            android:textSize="13sp"
            android:textColor="@color/blanco"
            android:textStyle="bold"
            android:background="@drawable/fondo_boton_magenta"
            android:textAllCaps="false"
            android:minHeight="0dp"
            android:paddingEnd="16dp"
            android:paddingStart="16dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp" />
    </LinearLayout>
</LinearLayout>
