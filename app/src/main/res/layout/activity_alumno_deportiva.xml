<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/drawer_layout">
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/gris_fondo">
        <include
            layout="@layout/barra_superior" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Información deportiva"
                        android:textSize="26sp"
                        android:textColor="@color/negro"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Información deportiva y estadística del alumno."
                        android:textSize="13sp"
                        android:textColor="@color/gris"
                        android:layout_marginTop="4dp" />
                    <View
                        android:layout_width="50dp"
                        android:layout_height="4dp"
                        android:background="@color/magenta"
                        android:layout_marginTop="10dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/fondo_header_alumno"
                    android:padding="18dp"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/txt_alumno_avatar"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:text=""
                            android:textSize="20sp"
                            android:textColor="@color/blanco"
                            android:textStyle="bold"
                            android:background="@drawable/fondo_avatar_grande"
                            android:gravity="center" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp">
                            <TextView
                                android:id="@+id/txt_alumno_nombre"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="20sp"
                                android:textColor="@color/blanco"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/txt_alumno_info"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="12sp"
                                android:textColor="@color/gris_claro"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <Button
                        android:id="@+id/boton_regresar"
                        android:text="← Regresar"
                        android:textSize="13sp"
                        android:textColor="@color/blanco"
                        android:textStyle="bold"
                        android:background="@drawable/fondo_boton_magenta"
                        android:textAllCaps="false"
                        android:minHeight="0dp"
                        android:paddingEnd="16dp"
                        android:paddingStart="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:layout_marginTop="14dp" />
                </LinearLayout>
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tab_personal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Información Personal"
                            android:textSize="13sp"
                            android:textColor="@color/gris"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp" />
                        <TextView
                            android:id="@+id/tab_deportiva"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Información Deportiva"
                            android:textSize="13sp"
                            android:textColor="@color/magenta"
                            android:textStyle="bold"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:background="@drawable/fondo_tab_activo" />
                        <TextView
                            android:id="@+id/tab_financiera"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Información Financiera"
                            android:textSize="13sp"
                            android:textColor="@color/gris"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp" />
                        <TextView
                            android:id="@+id/tab_administrativa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Información Administrativa"
                            android:textSize="13sp"
                            android:textColor="@color/gris"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp" />
                    </LinearLayout>
                </HorizontalScrollView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/fondo_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Información deportiva"
                            android:textSize="16sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Alumno"
                                android:textSize="12sp"
                                android:textColor="@color/gris"
                                android:layout_weight="1" />
                            <TextView
                                android:id="@+id/det_nombre"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="@color/negro"
                                android:textStyle="bold"
                                android:layout_weight="1"
                                android:gravity="end" />
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/linea" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Fecha de nacimiento"
                                android:textSize="12sp"
                                android:textColor="@color/gris"
                                android:layout_weight="1" />
                            <TextView
                                android:id="@+id/det_fecha_nac"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="@color/negro"
                                android:textStyle="bold"
                                android:layout_weight="1"
                                android:gravity="end" />
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/linea" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Edad"
                                android:textSize="12sp"
                                android:textColor="@color/gris"
                                android:layout_weight="1" />
                            <TextView
                                android:id="@+id/det_edad"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="@color/negro"
                                android:textStyle="bold"
                                android:layout_weight="1"
                                android:gravity="end" />
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/linea" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Número"
                                android:textSize="12sp"
                                android:textColor="@color/gris"
                                android:layout_weight="1" />
                            <TextView
                                android:id="@+id/det_numero"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="@color/negro"
                                android:textStyle="bold"
                                android:layout_weight="1"
                                android:gravity="end" />
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/linea" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Nombre playera"
                                android:textSize="12sp"
                                android:textColor="@color/gris"
                                android:layout_weight="1" />
                            <TextView
                                android:id="@+id/det_playera"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="@color/negro"
                                android:textStyle="bold"
                                android:layout_weight="1"
                                android:gravity="end" />
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/linea" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Categoría"
                                android:textSize="12sp"
                                android:textColor="@color/gris"
                                android:layout_weight="1" />
                            <TextView
                                android:id="@+id/det_categoria"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="@color/negro"
                                android:textStyle="bold"
                                android:layout_weight="1"
                                android:gravity="end" />
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/linea" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/fondo_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Estadísticas"
                            android:textSize="16sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Partidos"
                                android:textSize="12sp"
                                android:textColor="@color/gris"
                                android:layout_weight="1" />
                            <TextView
                                android:id="@+id/det_partidos"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="@color/negro"
                                android:textStyle="bold"
                                android:layout_weight="1"
                                android:gravity="end" />
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/linea" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Goles"
                                android:textSize="12sp"
                                android:textColor="@color/gris"
                                android:layout_weight="1" />
                            <TextView
                                android:id="@+id/det_goles"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="@color/negro"
                                android:textStyle="bold"
                                android:layout_weight="1"
                                android:gravity="end" />
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/linea" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/fondo_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Evaluación"
                            android:textSize="16sp"
                            android:textColor="@color/negro"
                            android:textStyle="bold"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Estado"
                                android:textSize="12sp"
                                android:textColor="@color/gris"
                                android:layout_weight="1" />
                            <TextView
                                android:id="@+id/det_eval_estado"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="@color/negro"
                                android:textStyle="bold"
                                android:layout_weight="1"
                                android:gravity="end" />
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/linea" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Promedio"
                                android:textSize="12sp"
                                android:textColor="@color/gris"
                                android:layout_weight="1" />
                            <TextView
                                android:id="@+id/det_eval_promedio"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="@color/negro"
                                android:textStyle="bold"
                                android:layout_weight="1"
                                android:gravity="end" />
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/linea" />
                    </LinearLayout>
                    <Button
                        android:id="@+id/boton_evaluacion"
                        android:text="Consultar evaluación"
                        android:textSize="13sp"
                        android:textColor="@color/blanco"
                        android:textStyle="bold"
                        android:background="@drawable/fondo_boton_magenta"
                        android:textAllCaps="false"
                        android:minHeight="0dp"
                        android:paddingEnd="16dp"
                        android:paddingStart="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
                <Button
                    android:id="@+id/boton_editar"
                    android:text="Editar datos deportivos"
                    android:textSize="13sp"
                    android:textColor="@color/magenta"
                    android:textStyle="bold"
                    android:background="@drawable/fondo_boton_borde"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:paddingEnd="16dp"
                    android:paddingStart="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:minWidth="0dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <include
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        layout="@layout/menu_lateral" />
</androidx.drawerlayout.widget.DrawerLayout>
